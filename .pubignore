# ==============================================================================
# .pubignore: controls what `dart pub publish` uploads to pub.dev.
# ==============================================================================
# IMPORTANT: pub reads this file INSTEAD OF .gitignore for this directory, not
# in addition to it. Every exclusion that matters for publishing has to be
# repeated here, secret patterns included, or files that .gitignore was keeping
# out of git end up inside the published archive. Keep the two files in sync
# whenever you edit either one.
#
# See https://dart.dev/tools/pub/publishing#what-files-are-published

# ------------------------------------------------------------------------------
# Development-only sources
# ------------------------------------------------------------------------------
# These are committed to git on purpose, but consumers of the package have no
# use for them and they make up most of the archive size.

# Test suite.
test/

# Internal probe and debug scripts (probe_cache.dart, dump_body.dart, ...).
tool/

# Internal design notes. Excluding this also settles pub's warning about the
# plural top-level `docs/` directory name.
docs/

# Repository automation and meta.
.github/
.gitlab-ci.yml
.editorconfig

# Deliberately NOT excluded:
#   example/          pub.dev renders it and awards package points for it.
#   bin/generate.dart the user-facing OAuth login helper
#                     (`dart run open_ai_anthropic:generate`).
#   analysis_options.yaml  pana analyzes the published package with it.

# ------------------------------------------------------------------------------
# Mirrored from .gitignore
# ------------------------------------------------------------------------------
# See the shadowing note at the top. Do not delete these just because
# .gitignore already lists them.

# Secrets and credentials.
.env
.env.*
!.env.example
!.env.sample
!.env.template
claude_credentials.json
claude_code_credentials.json
.credentials.json
*credentials*.json
*credentials*.yaml
secrets.json
token.json
tokens.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# Build and tool output.
.dart_tool/
build/
.packages
pubspec.lock
doc/api/
coverage/
lcov.info
.test_coverage.dart
*.aotsnapshot
*.dill
*.jit
*.jitsnapshot
*.snapshot
*.exe

# Editors and IDEs.
.idea/
*.iml
*.ipr
*.iws
.vscode/
.vs/
*.swp
*.swo
*~
\#*\#
.history/

# Operating system.
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*

# Local scratch.
references/
*.log
logs/
